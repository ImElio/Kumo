<Window x:Class="Kumo.App.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mascot="clr-namespace:Kumo.App.Mascot"
        Title="Kumo updates"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome x:Name="Chrome" CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary Source="../Windows/KumoStyles.xaml" />
  </Window.Resources>

  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="Kumo updates" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
      <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
              Click="OnClose" AutomationProperties.Name="Close" />

      <DockPanel Grid.Row="1" Margin="28,4,28,24" LastChildFill="True">
        <DockPanel DockPanel.Dock="Top">
          <mascot:KumoMascot x:Name="Mascot" Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Detail" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DockPanel>

        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Top" Margin="80,14,0,0" Visibility="Collapsed">
          <ProgressBar x:Name="Progress" Height="6" Maximum="1" AutomationProperties.Name="Update progress" />
          <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel x:Name="Actions" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />

        <Border x:Name="NotesCard" Margin="0,16,0,0" Padding="0" CornerRadius="8" BorderThickness="1" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
            <ContentControl x:Name="Notes" Focusable="False" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Border>
</Window>
