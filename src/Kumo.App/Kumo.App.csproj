<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Kumo</AssemblyName>
    <RootNamespace>Kumo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Kumo.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>..\..\assets\icons\kumo.ico</ApplicationIcon>
    <!-- WPF0001: Window.ThemeMode (Fluent styling for Settings and About) is still flagged experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KumoUpdateRepository" Value="$(KumoUpdateRepository)" />
    <AssemblyMetadata Include="KumoUpdatePublisher" Value="$(KumoUpdatePublisher)" />
  </ItemGroup>

  <!-- Builds meant for public download must know where their updates come from; an empty value would leave every
       user on that version without update notices. Local and CI development builds leave KumoPublicRelease unset. -->
  <Target Name="ValidatePublicReleaseConfiguration" BeforeTargets="CoreCompile" Condition="'$(KumoPublicRelease)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Public release builds must use the Release configuration." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(KumoUpdateRepository)', '^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]{1,100}$'))"
           Text="Public release builds need KumoUpdateRepository set to the owner/name of the GitHub repository that publishes updates." />
    <Error Condition="$(Version.Contains('-dev'))" Text="Development versions ($(Version)) are never published." />
    <Warning Condition="'$(KumoUpdatePublisher)' == ''"
             Text="KumoUpdatePublisher is empty: this build will report updates but never install them by itself (installers are not signed yet)." />
  </Target>

  <ItemGroup>
    <Resource Include="Mascot\Images\*.png" />
    <Content Include="..\..\assets\icons\kumo.ico" Link="kumo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SkiaSharp's native package carries an 80 MB symbol file that is only useful for debugging Skia itself. -->
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Kumo.Core\Kumo.Core.csproj" />
    <ProjectReference Include="..\Kumo.Operations\Kumo.Operations.csproj" />
    <ProjectReference Include="..\Kumo.Windows\Kumo.Windows.csproj" />
  </ItemGroup>

</Project>
