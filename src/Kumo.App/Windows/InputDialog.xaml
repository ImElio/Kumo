<Window x:Class="Kumo.App.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20" Width="320">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10" />
    <TextBox x:Name="PageInput" Visibility="Collapsed" />
    <StackPanel x:Name="PasswordInputs" Visibility="Collapsed">
      <PasswordBox x:Name="Password" AutomationProperties.Name="Password" />
      <TextBlock Text="Repeat the password" Margin="0,10,0,4" />
      <PasswordBox x:Name="Confirmation" AutomationProperties.Name="Repeat the password" />
    </StackPanel>
    <TextBlock x:Name="Hint" TextWrapping="Wrap" Opacity="0.72" FontSize="12" Margin="0,8,0,0" />
    <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#C42B1C" Margin="0,6,0,0" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Assertive" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ConfirmButton" MinWidth="88" IsDefault="True" Click="OnConfirm" />
      <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
