<Window x:Class="Kumo.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mascot="clr-namespace:Kumo.App.Mascot"
        Title="About Kumo"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary Source="KumoStyles.xaml" />
  </Window.Resources>

  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
              Click="OnCloseClick" AutomationProperties.Name="Close" />

      <StackPanel Grid.Row="1" Margin="36,0,36,28">
        <Grid HorizontalAlignment="Center" Width="132" Height="132">
          <Ellipse Fill="{StaticResource KumoAccent}" Opacity="0.14" />
          <mascot:KumoMascot Width="112" Height="112" />
        </Grid>
        <TextBlock Text="Kumo" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" Margin="0,6,0,0">
          <TextBlock x:Name="VersionText" FontSize="12" />
        </Border>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,16,0,0"
                   Text="A small file companion for Windows. Drag files from File Explorer, tap Shift, and pick what to do." />

        <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
          <Border Style="{StaticResource Chip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE8D7;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Works offline" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE77B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="No account" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE72E;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="No telemetry" FontSize="12" />
            </StackPanel>
          </Border>
        </WrapPanel>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" MinHeight="0">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Open source" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                       Text="Released under the MIT License. Built with SkiaSharp and PDFsharp 6.2 (both MIT); PDF pages are rendered by Windows." />
          </StackPanel>
        </Border>

        <Button Content="Close" Click="OnCloseClick" IsDefault="True" IsCancel="True" MinWidth="120" HorizontalAlignment="Center"
                Margin="0,20,0,0" Style="{DynamicResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
