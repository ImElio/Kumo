<Window x:Class="Kumo.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mascot="clr-namespace:Kumo.App.Mascot"
        Title="Kumo Settings"
        Width="900" Height="640" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary Source="KumoStyles.xaml" />
  </Window.Resources>

  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <mascot:KumoMascot Width="20" Height="20" />
        <TextBlock Text="Kumo Settings" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize" />
        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseClick" AutomationProperties.Name="Close" />
      </StackPanel>

      <!-- Navigation -->
      <DockPanel Grid.Row="1" Grid.RowSpan="2" Margin="12,8,8,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,18">
          <mascot:KumoMascot Width="44" Height="44" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Kumo" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="SidebarVersion" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                 SelectionChanged="OnNavigate" AutomationProperties.Name="Settings sections">
          <ListBoxItem Tag="General">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE713;" FontSize="16" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Interaction">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE7C9;" FontSize="16" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Interaction" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Files">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE8B7;" FontSize="16" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Files" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Updates">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE895;" FontSize="16" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Updates" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Advanced">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource KumoGlyphs}" Text="&#xE90F;" FontSize="16" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Advanced" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>

      <!-- Pages -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,8,28,16">
        <Grid MaxWidth="760" HorizontalAlignment="Stretch">

          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7E8;" />
                <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Start with Windows" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Kumo waits quietly in the notification area after you sign in." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE790;" />
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Theme" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Theme" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Colours of the radial menu and these windows." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xEA8F;" />
                <ComboBox x:Name="NotificationsBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Notifications" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Notifications" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Results of work that finishes after the menu has closed." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE774;" />
                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Language" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Language" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="More languages are planned." />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="InteractionPage" Visibility="Collapsed">
            <TextBlock Text="Interaction" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7C9;" />
                <ComboBox x:Name="ActivationBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Open while dragging" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Open while dragging" />
                  <TextBlock x:Name="ActivationHint" Style="{StaticResource CardDescription}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE765;" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Orientation="Horizontal">
                  <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextAlignment="Center"
                           AutomationProperties.Name="Keyboard shortcut. Focus this field and press the new combination."
                           PreviewKeyDown="OnHotkeyKeyDown" />
                  <CheckBox x:Name="HotkeyEnabled" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Enable the keyboard shortcut" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Keyboard shortcut" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Opens the menu for the files selected in File Explorer. Click the field and press a combination with Ctrl, Alt or Win." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE71E;" />
                <ComboBox x:Name="MenuSizeBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Menu size" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Menu size" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Diameter of the radial menu." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE776;" />
                <ComboBox x:Name="MotionBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200" AutomationProperties.Name="Motion" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Motion" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Short transitions when the menu opens or changes." />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="FilesPage" Visibility="Collapsed">
            <TextBlock Text="Files" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE74E;" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Where results are saved" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="Kumo never overwrites an original." />
                  </StackPanel>
                </DockPanel>
                <StackPanel Margin="36,10,0,2">
                  <RadioButton x:Name="OutputBeside" Content="Next to the original files" GroupName="Output" Margin="0,2" />
                  <RadioButton x:Name="OutputFolder" Content="In this folder" GroupName="Output" Margin="0,2" />
                  <DockPanel Margin="28,6,0,0" IsEnabled="{Binding IsChecked, ElementName=OutputFolder}">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseOutput" />
                    <TextBox x:Name="OutputPath" AutomationProperties.Name="Output folder" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE74D;" />
                <CheckBox x:Name="PreserveOriginals" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Keep original files" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Keep original files" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="When off, an original goes to the Recycle Bin after its result has been saved." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE8C8;" />
                <ComboBox x:Name="CollisionBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="240" AutomationProperties.Name="If the result name exists" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="If the result name exists" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Originals and files from the same batch are never replaced." />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
            <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE946;" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CurrentVersionText" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="InstallationText" Style="{StaticResource CardDescription}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE895;" />
                <Button x:Name="UpdateActionButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="150" Click="OnUpdateAction" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CardTitle}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="UpdateStatusDetail" Style="{StaticResource CardDescription}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="WhatsNewCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE789;" Foreground="{StaticResource KumoAccent}" />
                <Button Content="See what's new" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="130"
                        Click="OnSeeWhatsNew" Style="{DynamicResource AccentButtonStyle}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="WhatsNewTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="WhatsNewDate" Style="{StaticResource CardDescription}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE8AB;" />
                  <ComboBox x:Name="UpdateChannelBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="240" AutomationProperties.Name="Update channel" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Update channel" />
                    <TextBlock x:Name="ChannelDescription" Style="{StaticResource CardDescription}" />
                  </StackPanel>
                </DockPanel>
                <DockPanel x:Name="DevelopmentWarning" Margin="36,10,0,0" Visibility="Collapsed">
                  <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource KumoGlyphs}" Text="&#xE7BA;" FontSize="14" Margin="0,1,8,0"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                  <TextBlock Style="{StaticResource CardDescription}" Margin="0"
                             Text="Experimental builds may be unstable. Development builds aren't published yet, so this channel currently offers alpha, beta and release candidate versions." />
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE823;" />
                <CheckBox x:Name="AutomaticUpdates" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Automatically check for updates" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Automatically check for updates" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Check for new versions automatically." />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
            <TextBlock Text="Advanced" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xEC4A;" />
                <ComboBox x:Name="ConcurrencyBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="120" AutomationProperties.Name="Files processed at once" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Files processed at once" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Higher is faster for big batches but uses more memory." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xEBE8;" />
                <CheckBox x:Name="DiagnosticLogging" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Detailed diagnostic logging" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Detailed diagnostic logging" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="Logs stay on this computer for seven days. Detailed logs include file paths." />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardGlyph}" Text="&#xED25;" />
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Content="Open folder" MinWidth="120" Click="OnOpenLogs" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Logs" />
                  <TextBlock Style="{StaticResource CardDescription}" Text="%LOCALAPPDATA%\Kumo\logs" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2" Grid.Column="1" Padding="24,12,28,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SaveButton" Content="Save" MinWidth="110" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
          <Button Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
