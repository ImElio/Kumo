<Window x:Class="Kumo.App.Windows.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,16,20,16">
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="Ratios" Orientation="Horizontal" VerticalAlignment="Center"
                  AutomationProperties.Name="Aspect ratio" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
        <Button Content="Reset" MinWidth="80" Click="OnReset" />
        <Button x:Name="SaveButton" Content="Crop" MinWidth="88" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
      </StackPanel>
    </Grid>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="SizeText" DockPanel.Dock="Right" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="Hint" Opacity="0.72" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0" />
    </DockPanel>

    <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
  </DockPanel>
</Window>
